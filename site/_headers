# App bundles are content-hashed by Vite (assets/*.js / *.css include a hash),
# so a changed file gets a new URL and an unchanged URL is byte-identical
# forever. Long edge+browser caching here is safe and never touches per-user
# data (all /api/* JSON is `no-store` from the Worker + client no-store/_ts).
/products/split-task/app/assets/*
  Cache-Control: public, max-age=31536000, immutable